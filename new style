*{
    margin: 0;
    padding: 0;
}
.header{
    display: flex;
    background-color: rgb(180, 0, 69)
}
h2{
    padding: 30px 50px;
}
.link{
    font-size: 20px;
    display: flex;
    margin-left: auto;
    padding: 30px 50px;
    gap:20px
    
}
a{
    text-decoration: none;
    color: rgb(242, 245, 245);
}
a:hover{
    color: rgb(154, 163, 155);}
span{
    color: rgb(42, 165, 48);
}
.img{
    background-image:url("https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1600&q=80");
     width: 100%;
    height: 500px;
    object-fit: cover;
    background-position: center;
    text-align: left;
    padding: 150px 160px;
    box-sizing: border-box;
    color: aliceblue;

}
.img h1{
    font-size:50px ;
}
.img p{
    font-size: 20px;
}
.img input{
    border-radius:60px;
    background-color: brown;
    color: beige;
    cursor: pointer;
    border: none;
    padding: 20px 30px;
    font-size:15px;

}
.img input:hover{
background-color: rgb(112, 28, 28);
}

.body h2{
   font-size:30px ;
   padding-left: 70px;
}
.body p{
    padding-left: 70px;
    font-size: 17px;
}
.card {
    display: flex;
    gap: 25px;
    width: 90%;
    margin: 30px auto;

}
.badge {
    position: absolute;
    top: 15px;
    right: 15px;
    background-color: #8d1a40;
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 18px;
    font-weight: bold;
}

.first,
.second,
.third {
    flex: 1;
    min-width: 0;
    padding: 30px 25px;
    box-sizing: border-box;
    border-radius: 18px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
}
.first {
    position: relative;
    background-color: #eee7ff;
}

.second {
    background-color: #e0f2fe;
}

.third {
    background-color: #ddf8ee;
}
.card input{
    border: none;
    color: rgb(71, 23, 104);
    cursor: pointer;
    font-size: 15px;
}
.card input:hover{
color: #210655;
}
footer {
    background-color: rgb(180, 0, 69);
    color: white;
    text-align: center;
    padding: 20px 10px;
    line-height: 0px;
}

footer h2 {
    margin-bottom: 5px;
    font-size: 22px;
}
footer p {
    font-size: 14px;
    margin: 0;
}

@media screen and (max-width: 768px) {

    .header {
        flex-direction: column;
        align-items: center;
    }

    .header h2 {
        padding: 20px 10px;
        text-align: center;
    }

    .link {
        margin-left: 0;
        padding: 10px 0 20px;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
        font-size: 16px;
    }

    .img {
        width: 100%;
        height: auto;
        min-height: 400px;
        padding: 80px 20px;
        background-size: cover;
        background-position: center;
    }

    .img h1 {
        font-size: 32px;
    }

    .img p {
        font-size: 16px;
    }

    .img input {
        padding: 12px 20px;
        font-size: 14px;
    }

    .body h2 {
        font-size: 25px;
        padding: 20px;
    }

    .body p {
        padding: 0 20px;
        font-size: 15px;
    }

    .card {
        flex-direction: column;
        width: 90%;
        gap: 20px;
    }

    .first,
    .second,
    .third {
        width: 100%;
        padding: 30px 20px;
    }

    .card h1 {
        font-size: 23px;
    }

    footer {
        line-height: normal;
        padding: 20px 10px;
    }

    footer h2 {
        padding: 15px 0;
        font-size: 20px;
    }

    footer p {
        font-size: 14px;
    }
}
