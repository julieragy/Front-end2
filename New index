<head>
    <title>Creative Academy</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header class="header">
        <h2>Creative <span>Academy</span></h2>
        <div class="link">
            <a href="#home">Home</a>
            <a href="#courses">Courses</a>
            <a href="#about">About</a>
        </div>
    </header>
    <div class="img" id="home">
        <h1>Learn Today<br>,Build<span> Tomorrow</span></h1><br>
        <p>
            Join our academy and gain the skills you need to create your dream career
            <br>in technology.
        </p><br>
        <input type="submit" value="Get Started"
               onclick="document.getElementById('courses').scrollIntoView({behavior:'smooth'})">
    </div>
    <div class="body" id="courses">
        <h2>Our Popular Courses</h2>
        <p>Explore our top courses and start your learning journey</p>
    </div>
    <div class="card">
        <div class="first">
            <span class="badge">New</span>
            <h1>Web Development</h1>
            <p>Learn HTML, CSS and JavaScript to build <br>amazing websites.</p><br>
            <input type="button" value="Learn More →">
        </div>
        <div class="second">
            <h1>UI/UX Design</h1><br>
            <p>Discover how to create beautiful and user-<br>friendly interfaces.</p><br>
            <input type="button" value="Learn More →">
        </div>
        <div class="third">
            <h1>Data Science</h1><br>
            <p>Turn data into useful insights and make better<br> decisions.</p><br>
            <input type="button" value="Learn More →">
        </div>
    </div>
    <footer id="about">
        <h2>Creative <span>Academy</span></h2>
        <p>Learn new skills. Build your future.</p>
    </footer>
</body>
</html>
